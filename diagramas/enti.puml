@startuml

' Configuración de estilo
!theme plain
hide circle
skinparam linetype ortho

' --- CLASES (ENTIDADES) ---

class Cliente {
  - UUID id
  - String dni
  - String nombre
  - String email
  - String password
  - boolean admin
  + List<Tarjeta> tarjetas
  + List<Compra> compras
  + List<Venta> ventas
}

class Tarjeta {
  - UUID id
  - String codigoTarjeta
  - boolean valida
  - Cliente cliente
}

class Inmueble {
  - UUID idInmueble
  - String localidad
  - String direccion
  - Float precio
  - List<String> pathFotos
  - Venta venta
  - List<Compra> compras
}

class Compra {
  - UUID idCompra
  - Date fechaCompra
  - float precioCompra
  - Cliente cliente
  - Inmueble inmueble
  - List<Servicio> servicios
}

class Venta {
  - UUID idVenta
  - Date fechaVenta
  - float precioVenta
  - Cliente cliente
  - Inmueble inmueble
  - List<Servicio> servicios
}

class Servicio {
  - UUID idServicio
  - String descripcion
  - Float coste
  - Date fechaAplicacion
  - Compra compra
  - Venta venta
}

enum TipoServicio {
  LIMPIEZA
  MANTENIMIENTO
  REPARACION
  PINTURA
  FONTANERIA
  OTROS
}

' --- RELACIONES ---

' Cliente y sus relaciones
Cliente "1" -down- "0..*" Tarjeta : tiene >
Cliente "1" -right- "0..*" Compra : realiza >
Cliente "1" -right- "0..*" Venta : vendedor en >

' Inmueble y sus relaciones
Inmueble "1" -down- "0..1" Venta : < objeto de venta (1:1)
Inmueble "1" -up- "0..*" Compra : recibe ofertas >

' Relaciones de Compra y Venta (Transacciones)
Compra "1" -down- "0..*" Servicio : incluye >
Venta "1" -down- "0..*" Servicio : incluye (final) >

' Dependencia de Enum
Servicio .right.> TipoServicio : es de tipo >

@enduml